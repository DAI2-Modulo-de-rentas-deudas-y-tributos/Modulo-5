# Configuración local de `docker compose`. Copiar a `.env` (que Git ignora) y completar
# las cuatro variables OBLIGATORIAS. Valores: 8 o más caracteres, sin espacios, comillas
# ni barras invertidas. Si falta alguna, `docker compose up` se corta indicando cuál.
# Si se cambian después del primer arranque: `docker compose down -v` y volver a levantar.

# OBLIGATORIA. Contraseña del usuario de PostgreSQL.
POSTGRES_PASSWORD=
# OBLIGATORIA. Contraseña del usuario de RabbitMQ (backend y consola http://localhost:15672).
RABBITMQ_PASSWORD=
# OBLIGATORIA. Secreto interno con el que se crea el primer usuario DEMO (supervisor).
RENTAS_DEMO_BOOTSTRAP_PASSWORD=
# OBLIGATORIA. Contraseña de ingreso de los usuarios DEMO: supervisor, rentas, cajero,
# auditor y contribuyente.
RENTAS_DEMO_USERS_PASSWORD=

# Opcional. Nombre de la base de datos.
POSTGRES_DB=rentas
# Opcional. Usuario de PostgreSQL.
POSTGRES_USER=rentas
# Opcional. Usuario de RabbitMQ.
RABBITMQ_USER=m5-local

# Opcional. Puertos publicados en el equipo; cambiarlos sólo si ya están ocupados.
FRONTEND_PORT=5173
BACKEND_PORT=8080
POSTGRES_PORT=5432
RABBITMQ_MANAGEMENT_PORT=15672

# Opcional. Orígenes admitidos por CORS cuando el frontend llama al backend sin el proxy.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
# Opcional. Duración de la sesión DEMO (formato ISO-8601; PT8H = 8 horas).
RENTAS_DEMO_SESSION_TTL=PT8H
