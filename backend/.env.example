# Docker Compose: PostgreSQL y publicación de puertos
POSTGRES_DB=rentas
POSTGRES_USER=rentas
# Obligatoria para Compose: completar sólo en el entorno local, nunca versionar el valor.
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
SERVER_PORT=8080

# Ejecución directa de Spring Boot desde la terminal o el IDE
DB_URL=jdbc:postgresql://localhost:5432/rentas
DB_USER=rentas
DB_PASSWORD=
OUTBOX_DELAY_MS=5000

# Por defecto no conecta con Core; usar rabbitmq sólo con un broker aislado/autorizado.
BROKER_ADAPTER=local-log
CORE_RABBITMQ_HOST=localhost
CORE_RABBITMQ_PORT=5672
CORE_RABBITMQ_USERNAME=m5-local
CORE_RABBITMQ_PASSWORD=CHANGE_ME
CORE_RABBITMQ_VHOST=/
CORE_RABBITMQ_HEALTH_ENABLED=false
CORE_RABBITMQ_EXCHANGE=muni.inbox
CORE_RABBITMQ_QUEUE=q.rentas
CORE_RABBITMQ_CONFIRM_TIMEOUT=5s
# Habilitar el listener sólo cuando q.rentas exista y Core haya autorizado el consumo.
CORE_RABBITMQ_CONSUMER_ENABLED=false

# Sólo DEMO/DEV: bootstrap único del primer SUPERVISOR con username/password del request.
RENTAS_SECURITY_DEV_MODE=false
RENTAS_DEMO_BOOTSTRAP_PASSWORD=
RENTAS_DEMO_SESSION_TTL=PT8H
# Orígenes exactos para llamadas cross-origin. El proxy Vite no necesita CORS.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
