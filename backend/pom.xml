<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-parent</artifactId><version>3.5.16</version><relativePath/></parent>
    <groupId>ar.gob.municipalidad</groupId><artifactId>rentas</artifactId><version>0.1.0-SNAPSHOT</version>
    <name>Módulo 5 - Rentas</name><description>Backend independiente para rentas, tributos, deudas y cobros</description>
    <properties>
        <java.version>17</java.version>
        <springdoc.version>2.8.9</springdoc.version>
        <jackson-bom.version>2.21.8</jackson-bom.version>
        <tomcat.version>10.1.61</tomcat.version>
        <rabbit-amqp-client.version>5.37.0</rabbit-amqp-client.version>
        <commons-lang3.version>3.18.0</commons-lang3.version>
        <log4j2.version>2.25.5</log4j2.version>
        <commons-compress.version>1.26.0</commons-compress.version>
        <netty.version>4.1.139.Final</netty.version>
        <postgresql.version>42.7.14</postgresql.version>
    </properties>
    <dependencyManagement>
        <dependencies>
            <!-- Fija la transitiva de Testcontainers; mantiene su scope test. -->
            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-compress</artifactId>
                <version>${commons-compress.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <dependencies>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-web</artifactId></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-data-jpa</artifactId></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-validation</artifactId></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-security</artifactId></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-actuator</artifactId></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-amqp</artifactId></dependency>
        <dependency><groupId>org.flywaydb</groupId><artifactId>flyway-core</artifactId></dependency>
        <dependency><groupId>org.flywaydb</groupId><artifactId>flyway-database-postgresql</artifactId></dependency>
        <dependency><groupId>org.postgresql</groupId><artifactId>postgresql</artifactId><scope>runtime</scope></dependency>
        <dependency><groupId>org.springdoc</groupId><artifactId>springdoc-openapi-starter-webmvc-ui</artifactId><version>${springdoc.version}</version></dependency>
        <dependency><groupId>com.h2database</groupId><artifactId>h2</artifactId><scope>test</scope></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-test</artifactId><scope>test</scope></dependency>
        <dependency><groupId>org.springframework.security</groupId><artifactId>spring-security-test</artifactId><scope>test</scope></dependency>
        <dependency><groupId>org.testcontainers</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
        <dependency><groupId>org.testcontainers</groupId><artifactId>postgresql</artifactId><scope>test</scope></dependency>
    </dependencies>
    <build><finalName>rentas-backend</finalName><plugins>
        <plugin><groupId>org.springframework.boot</groupId><artifactId>spring-boot-maven-plugin</artifactId></plugin>
        <plugin>
            <groupId>org.jacoco</groupId><artifactId>jacoco-maven-plugin</artifactId><version>0.8.12</version>
            <executions>
                <execution><goals><goal>prepare-agent</goal></goals></execution>
                <execution><id>report</id><phase>verify</phase><goals><goal>report</goal></goals></execution>
                <execution>
                    <id>coverage-check</id><phase>verify</phase><goals><goal>check</goal></goals>
                    <configuration><rules>
                        <rule><element>BUNDLE</element><limits><limit>
                            <counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.85</minimum>
                        </limit></limits></rule>
                        <rule><element>BUNDLE</element><includes>
                            <include>ar/gob/municipalidad/rentas/BillingService*</include>
                            <include>ar/gob/municipalidad/rentas/CreditBalanceService*</include>
                            <include>ar/gob/municipalidad/rentas/AdjustmentService*</include>
                            <include>ar/gob/municipalidad/rentas/ElectronicPaymentService*</include>
                            <include>ar/gob/municipalidad/rentas/ExemptionService*</include>
                            <include>ar/gob/municipalidad/rentas/LateChargeService*</include>
                            <include>ar/gob/municipalidad/rentas/LiquidationRunService*</include>
                            <include>ar/gob/municipalidad/rentas/LiquidationService*</include>
                            <include>ar/gob/municipalidad/rentas/PaymentPlanPrincipalLedger*</include>
                            <include>ar/gob/municipalidad/rentas/PaymentPlanService*</include>
                            <include>ar/gob/municipalidad/rentas/PaymentService*</include>
                            <include>ar/gob/municipalidad/rentas/PlanWorkflowService*</include>
                            <include>ar/gob/municipalidad/rentas/ReversalService*</include>
                            <include>ar/gob/municipalidad/rentas/DueDateProcessor*</include>
                        </includes><limits>
                            <limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.80</minimum></limit>
                            <limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>0.70</minimum></limit>
                        </limits></rule>
                    </rules></configuration>
                </execution>
            </executions>
        </plugin>
    </plugins></build>
    <profiles>
        <profile>
            <id>mutation-testing</id>
            <build><plugins><plugin>
                <groupId>org.pitest</groupId><artifactId>pitest-maven</artifactId><version>1.18.2</version>
                <dependencies><dependency>
                    <groupId>org.pitest</groupId><artifactId>pitest-junit5-plugin</artifactId><version>1.2.2</version>
                </dependency></dependencies>
                <configuration>
                    <targetClasses>
                        <param>ar.gob.municipalidad.rentas.BillingService*</param>
                        <param>ar.gob.municipalidad.rentas.CreditBalanceService*</param>
                        <param>ar.gob.municipalidad.rentas.AdjustmentService*</param>
                        <param>ar.gob.municipalidad.rentas.ElectronicPaymentService*</param>
                        <param>ar.gob.municipalidad.rentas.ExemptionService*</param>
                        <param>ar.gob.municipalidad.rentas.LateChargeService*</param>
                        <param>ar.gob.municipalidad.rentas.LiquidationRunService*</param>
                        <param>ar.gob.municipalidad.rentas.LiquidationService*</param>
                        <param>ar.gob.municipalidad.rentas.PaymentPlanPrincipalLedger*</param>
                        <param>ar.gob.municipalidad.rentas.PaymentPlanService*</param>
                        <param>ar.gob.municipalidad.rentas.PaymentService*</param>
                        <param>ar.gob.municipalidad.rentas.PlanWorkflowService*</param>
                        <param>ar.gob.municipalidad.rentas.ReversalService*</param>
                        <param>ar.gob.municipalidad.rentas.DueDateProcessor*</param>
                    </targetClasses>
                    <mutationThreshold>60</mutationThreshold>
                    <threads>4</threads>
                    <timeoutConstant>60000</timeoutConstant>
                    <timestampedReports>false</timestampedReports>
                </configuration>
            </plugin></plugins></build>
        </profile>
    </profiles>
</project>
