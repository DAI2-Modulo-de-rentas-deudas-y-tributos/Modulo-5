{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rentas.local/schemas/common-event-envelope.schema.json",
  "title": "EventEnvelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "eventType",
    "occurredAt",
    "sourceModule",
    "data"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[a-z][A-Za-z0-9]*$"
    },
    "eventVersion": {
      "type": "string",
      "maxLength": 20,
      "default": "1.0"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "sourceModule": {
      "type": "string",
      "maxLength": 60,
      "const": "rentas"
    },
    "correlationId": {
      "type": ["string", "null"],
      "format": "uuid"
    },
    "causationId": {
      "type": ["string", "null"],
      "format": "uuid"
    },
    "data": {
      "type": "object"
    }
  }
}
