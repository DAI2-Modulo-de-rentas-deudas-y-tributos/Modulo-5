{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:m5-rentas:event:paymentPlanRequested:1.0:data",
  "title": "paymentPlanRequested data (M5 proposal)",
  "description": "Shape emitted by ConfirmedOutboundEvents.PaymentPlanRequestedPayload. This schema validates data only; it is not M1/Core ratification.",
  "type": "object",
  "additionalProperties": false,
  "required": ["requestId", "citizenId", "debtIds", "totalDebt", "installments"],
  "properties": {
    "requestId": { "$ref": "#/$defs/uuid" },
    "citizenId": { "$ref": "#/$defs/uuid" },
    "debtIds": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/uuid" }
    },
    "totalDebt": { "type": "number", "exclusiveMinimum": 0 },
    "installments": { "type": "integer", "minimum": 1, "maximum": 2147483647 }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    }
  }
}
