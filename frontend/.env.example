# URL pública del backend de Rentas. Vacía = la app usa el dataset de demostración.
VITE_API_BASE_URL=http://localhost:8080

# Fuerza el dataset local aunque VITE_API_BASE_URL esté configurada.
VITE_USE_MOCKS=true

# Autenticación local de UI. Cambiar a core sólo cuando exista el contrato JWT.
VITE_AUTH_MODE=mock

# Envía X-Dev-* únicamente en auth mock y si el backend habilita dev-mode.
VITE_DEV_IDENTITY_HEADERS=false
