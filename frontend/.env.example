# Desarrollo local: URL vacía para usar /api mediante el proxy de Vite.
# En un build desplegado, indicar el origen HTTPS del backend (sin /api/v1).
VITE_API_BASE_URL=

# Login DEMO/DEV real contra PostgreSQL mediante sesión opaca X-Demo-Session.
# Cambiar a core sólo cuando exista el contrato JWT.
VITE_AUTH_MODE=mock
# Política de inactividad del frontend: aviso 60 segundos antes del cierre a los 15 minutos.
VITE_IDLE_TIMEOUT_MINUTES=15
VITE_IDLE_WARNING_SECONDS=60
