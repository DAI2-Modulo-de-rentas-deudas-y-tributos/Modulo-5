# Desarrollo local: URL vacía para usar /api mediante el proxy de Vite.
# En un build desplegado, indicar el origen HTTPS del backend (sin /api/v1).
VITE_API_BASE_URL=

# Login DEMO/DEV real contra PostgreSQL. No hay usuarios ni datos mock en la app.
# Cambiar a core sólo cuando exista el contrato JWT.
VITE_AUTH_MODE=mock

# Sólo para integración local con un backend en dev-mode. No usar en producción.
VITE_DEV_IDENTITY_HEADERS=true
