# URL pública del backend de Rentas. Vacía = URL relativa mediante el proxy de Vite.
VITE_API_BASE_URL=http://localhost:8080

# Datos de negocio: true = dataset local de mockDb. Ausente o false = API real.
# El login NUNCA usa esta bandera: va a POST /api/v1/dev-auth/login cuando VITE_AUTH_MODE=mock.
VITE_USE_MOCKS=false

# Autenticación DEMO/DEV. Cambiar a core sólo cuando exista el contrato JWT.
VITE_AUTH_MODE=mock

# Envía X-Dev-* con auth mock si el backend tiene RENTAS_SECURITY_DEV_MODE=true.
VITE_DEV_IDENTITY_HEADERS=true
